SECRET_KEY=django-insecure-change-me-in-production-use-a-50-char-random-string
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://resumejaadu:resumejaadu@db:5432/resumejaadu

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI Configuration (choose ONE)
# Option A: Groq Cloud Free Tier (get key at console.groq.com)
AI_MODEL=groq/llama-3.1-70b-versatile
GROQ_API_KEY=gsk_your_groq_key_here

# Option B: Local Ollama (100% offline, no API key needed)
# AI_MODEL=ollama/qwen2.5:7b
# OLLAMA_HOST=http://ollama:11434

# Storage (local dev — comment out for S3)
MEDIA_ROOT=media/
STATIC_ROOT=staticfiles/

# S3 Storage (production)
# USE_S3=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# Email (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
