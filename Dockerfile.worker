FROM debian:bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install Python + TeX Live full + poppler-utils for PDF thumbnails
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev \
    libpq-dev gcc \
    # TeX Live — full installation for broad template support
    texlive-full \
    # Poppler for pdftoppm (PDF thumbnail generation)
    poppler-utils \
    # FontAwesome and other icon fonts used by templates
    fonts-font-awesome \
    # Clean up
    && rm -rf /var/lib/apt/lists/*

# Symlink python3 to python
RUN ln -s /usr/bin/python3 /usr/bin/python

COPY requirements.txt .
RUN pip3 install --upgrade pip && pip3 install -r requirements.txt --break-system-packages

COPY . .

# Create non-root user for security
RUN addgroup --gid 1001 workergroup && \
    adduser --uid 1001 --gid 1001 --no-create-home --disabled-password workeruser && \
    chown -R workeruser:workergroup /app

USER workeruser
